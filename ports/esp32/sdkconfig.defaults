#
# Seeded for ADR 0019's hello-world originally; extended for ADR 0020's HAL
# backends, which is the first point this build actually needs PSRAM and a
# non-default CPU frequency to exist. Still "assumption, not measured" the
# same way kf_esp_pins.h and KF_DISPLAY_SPI_HZ are -- these are the settings
# the N16R8 module and this ADR's HAL code need to be internally consistent,
# not settings verified against a real running board yet.

CONFIG_IDF_TARGET="esp32s3"

# Matches the reference wokwi/esp-idf-hello-world project's diagram.json and
# this port's own wokwi.toml. The real device's actual flash size is still
# TBD -- see README.md's "The number to check first at bring-up" for the
# same caveat applied to KF_DISPLAY_SPI_HZ; flash size gets the same
# "assumption, not measured" treatment once real hardware is in hand.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Octal PSRAM, per the N16R8 module esp_memory.cpp's KF_POOL_EXTERNAL relies
# on (MALLOC_CAP_SPIRAM) -- without this, kf_mem_pool_acquire() for that pool
# returns NULL on real hardware, which kf_app_init() treats as fatal. Speed
# is 80M, not the faster 120M option Kconfig.spiram also offers: 120M needs
# specific board support this devkit's real capability is unconfirmed for,
# and 80M is the documented safe default -- another bring-up number to
# revisit once real hardware is in hand, not a performance choice made here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y

# SDIO probing OFF. This build does not touch the SD card yet -- esp_storage.
# cpp is NVS-only -- so this setting changes nothing today. It is here anyway
# because it is a MEASURED finding from first bring-up (2026-08-07, ADR 0024)
# and the alternative is rediscovering it later: sdmmc_init.c's
# sdmmc_io_reset() sends CMD52, a plain memory card answers with the
# function-number-error bit, and the mount aborts with what looks exactly
# like "no card is connected". Costing an evening once is enough.
CONFIG_SD_ENABLE_SDIO_SUPPORT=n

# 240MHz, the fastest option Kconfig.cpu offers for this target. Nothing
# about this ADR's HAL backends specifically requires it over the default
# clock -- it is here because the eventual pet + LVGL + Lua workload this
# hardware is being bought for (see ADR 0013/0014/0016/0017) will want the
# headroom, and there is no reason to bring the device up at a slower clock
# now only to raise it again once those land.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
